{
  "name": "bharatseva-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BharatSeva AI - an independent, multilingual, LLM-led agentic RAG assistant for Indian public-service information (IRCTC pilot).",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:local": "node scripts/dev-local.js",
    "db": "node scripts/local-db.js",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "test:server": "npm run test --workspace server",
    "test:client": "npm run test --workspace client",
    "test:e2e": "playwright test",
    "seed": "npm run seed --workspace server --",
    "ingest": "npm run ingest --workspace server --",
    "evaluate": "npm run evaluate --workspace server --"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
