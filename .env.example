# ---------------------------------------------------------------------------
# BharatSeva AI - environment configuration
#
# Copy this file to `.env` in the repository root and fill in the values.
# Never commit `.env`. The server validates every value at startup (Zod) and
# refuses to boot if something is invalid or missing.
#
# Local-only build: there is no Docker or CI component. You can use the
# bundled persistent local MongoDB (`npm run db` / `npm run dev:local`) or an
# Atlas cluster.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB -----------------------------------------------------------------
# Easiest local path: leave this as-is and run `npm run db` (or `npm run
# dev:local`, which starts the database and app together). Data persists in
# data/local-db.
#
# Atlas is optional. To use it, create a free cluster at
# https://cloud.mongodb.com, add a database user and your IP, then paste the
# SRV connection string:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bharatseva_ai
MONGODB_DB=bharatseva_ai

# --- Sessions ----------------------------------------------------------------
# Long random secret (>= 32 chars). Used to HMAC browser session tokens before
# they are stored. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-long-random-secret

# --- LLM provider ------------------------------------------------------------
# mock                -> deterministic, keyless demo agent (default)
# openai-compatible   -> any /chat/completions + tool-calling provider
#                        (OpenAI, Groq, OpenRouter, Together, vLLM, Ollama, ...)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=1200

# --- Embedding provider ------------------------------------------------------
# local               -> keyless, in-process multilingual model (recommended)
# mock                -> deterministic hash embeddings (no download; demo/tests)
# openai-compatible   -> any /embeddings compatible endpoint
#
# The local model is downloaded once into data/models and then runs offline.
# It uses Xenova/paraphrase-multilingual-MiniLM-L12-v2 (384 dimensions) by
# default. Set EMBEDDING_MODEL to use another transformers.js model.
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=384

# --- Vector store ------------------------------------------------------------
# local-vector -> keyless in-process cosine ranking over stored embeddings
# mongodb      -> MongoDB $text lexical search only (no vectors)
# atlas-vector -> Atlas Vector Search over the `embedding` field
# The Atlas adapter falls back to $text automatically (and says so) if the
# vector index is missing or the query fails.
VECTOR_STORE_PROVIDER=local-vector
VECTOR_INDEX_NAME=chunk_vector_index

# --- Observability and limits ------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
MAX_MESSAGE_LENGTH=4000
AGENT_MAX_STEPS=6
AGENT_MAX_RETRIEVAL_CALLS=3
AGENT_MAX_RUNTIME_MS=25000
AGENT_MAX_CONTEXT_MESSAGES=12
AGENT_MAX_EVIDENCE_CHUNKS=12

# --- Admin -------------------------------------------------------------------
# Leave empty to disable every admin endpoint (they answer 404). If set, admin
# requests must send `Authorization: Bearer <ADMIN_TOKEN>`. Minimum 24 chars.
ADMIN_TOKEN=
